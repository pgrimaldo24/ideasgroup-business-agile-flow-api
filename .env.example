# =============================================================================
#  AgileFlow — plantilla de variables de entorno
# =============================================================================
#  Este archivo SÍ se versiona: solo contiene valores de DESARROLLO.
#  El archivo real (.env) está en .gitignore y nunca se sube al repositorio.
#
#  PRIMER PASO OBLIGATORIO antes de levantar con Docker:
#      Linux/macOS:  cp .env.example .env
#      Windows:      copy .env.example .env
#
#  Luego:  docker compose up --build
#
#  Estas variables SOLO las consume Docker (docker-compose.yml las inyecta en
#  el contenedor como ConnectionStrings__Default, Jwt__Secret, etc.).
#  Para ejecutar en local con `dotnet run` NO hace falta este archivo:
#  esos valores viven en AgileFlow.Api/appsettings.Development.json.
#  Si cambias algo aquí, cámbialo también allá para que ambos modos coincidan.
# =============================================================================

# --- PostgreSQL --------------------------------------------------------------
# ⚠ Si cambias POSTGRES_USER / POSTGRES_PASSWORD después de haber levantado el
#   proyecto, el volumen ya está inicializado con las credenciales anteriores.
#   Hay que recrearlo:  docker compose down -v  &&  docker compose up --build
POSTGRES_DB=agileflow
POSTGRES_USER=agileflow_svc
POSTGRES_PASSWORD=CTcpOffQEVziYjXnGHK9MHfAvU65

# Puerto publicado en el HOST. Dentro de la red de Docker siempre es 5432.
# Se usa 5433 para no chocar con una instalación nativa de PostgreSQL.
# appsettings.Development.json apunta a este mismo puerto para el modo local.
POSTGRES_HOST_PORT=5433

# --- JWT ---------------------------------------------------------------------
# Clave de firma HMAC-SHA256: mínimo 32 caracteres. Generar una propia con:
#   openssl rand -hex 64
#   PowerShell: -join ((1..64) | % { '{0:x2}' -f (Get-Random -Max 256) })
JWT_SECRET=e488b74d667d6b5c1c245ef352ef8c32e39668b93357afe16c0b17fc64ed5b00378ed3c9292baf7f3cd320f70a7eb31f2a1fde88f233400b07d11f08d16eed30
JWT_ISSUER=AgileFlow.Api
JWT_AUDIENCE=AgileFlow.Client

# --- Hash de contraseñas -----------------------------------------------------
# Secreto extra que se concatena al hash. ⚠ Debe ser IDÉNTICO al de
# appsettings.Development.json: si difiere, los usuarios sembrados por un modo
# no podrán autenticarse desde el otro.
PASSWORD_PEPPER=pepper-de-desarrollo-cambiar-en-produccion

# --- CORS / frontend ---------------------------------------------------------
FRONTEND_URL=http://localhost:4200

# --- Usuarios precargados (seed) ---------------------------------------------
# Se crean al arrancar la API, después de aplicar las migraciones. El proceso es
# idempotente: reiniciar no los duplica.
# ⚠ Cambiar una contraseña aquí NO actualiza al usuario si ya existe en la BD;
#   para regenerarlos:  docker compose down -v  &&  docker compose up --build
SEED_ADMIN_FULLNAME=Administrador Demo
SEED_ADMIN_EMAIL=admin@ideasgroup.demo
SEED_ADMIN_PASSWORD=Kanban#2026

SEED_USER_FULLNAME=Usuario Demo
SEED_USER_EMAIL=usuario@ideasgroup.demo
SEED_USER_PASSWORD=Kanban#2026
