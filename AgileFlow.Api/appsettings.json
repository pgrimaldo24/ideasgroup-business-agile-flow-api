{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // Este archivo define el ESQUEMA de configuración y los valores no sensibles.
  // Los secretos quedan en null a propósito: así, si no se proveen, la app falla
  // al arrancar con un mensaje claro en vez de continuar con valores vacíos.
  //
  // De dónde se obtienen los valores reales, por orden de precedencia (gana el último):
  //   1. appsettings.json                (este archivo: defaults no sensibles)
  //   2. appsettings.Development.json    (ejecución local con F5 / dotnet run)
  //   3. Variables de entorno            (Docker: docker-compose.yml + .env)
  //      Convención ASP.NET Core: "__" separa secciones -> Jwt__Secret = Jwt:Secret
  "ConnectionStrings": {
    "Default": null
  },
  "Jwt": {
    "Secret": null,
    "Issuer": "AgileFlow.Api",
    "Audience": "AgileFlow.Client",
    "ExpirationMinutes": "60"
  },
  "Security": {
    "PasswordPepper": null
  },
  "Cors": {
    "AllowedOrigin": "http://localhost:4200"
  },
  // Usuarios precargados. Vacío aquí a propósito: se definen por entorno
  // (appsettings.Development.json en local, Seed__Users__N__* en Docker).
  // Sin usuarios configurados, DbSeeder simplemente no siembra nada.
  "Seed": {
    "Users": []
  }
}
